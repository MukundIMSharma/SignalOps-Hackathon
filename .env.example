# Copy to .env and fill in. Never commit .env.

# LLM provider used by signalops-backend
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Business APIs (direct URLs: health checks / test setup only)
ORDERS_API_URL=http://localhost:8001
INVENTORY_API_URL=http://localhost:8002

# Synapse
SYNAPSE_API_KEY=
