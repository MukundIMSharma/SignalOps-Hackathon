# Copy to .env and fill in. Never commit .env.

# LLM used by signalops-backend (Google Gemini, free tier)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
# used when the primary model errors or times out (free tier often returns 503)
LLM_FALLBACK_MODEL=gemini-3.5-flash

# Business APIs (direct URLs: health checks / test setup only)
ORDERS_API_URL=http://localhost:8001
INVENTORY_API_URL=http://localhost:8002

# Synapse MCP runner (same key you saved with `synapse config set-key`)
SYNAPSE_API_KEY=

# Synapse MCP server ids printed by `synapse build` (defaults = this project's servers)
ORDERS_MCP_SERVER_ID=6ab65632-0790-4e06-8b0e-77bb3d448920
INVENTORY_MCP_SERVER_ID=bf451b7a-95c9-4658-b2a6-91708fb7ef84
